# ============================================================
# COUNCIL — 환경변수
# ============================================================
# 1단계 (클로즈 베타): 개발자 키. 서버에서만 사용.
# 2단계 (오픈 베타) : 사용자 BYOK. 이 파일에 키 없이도 동작.
# ============================================================

# Anthropic (1단계 서버 호출용. 없으면 BYOK 강제)
ANTHROPIC_API_KEY=

# Supabase (없으면 LocalStorage 폴백)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# 어드민 페이지 (페르소나·프롬프트 관리)
# ============================================================
# 8자 이상. 미설정 시 /admin 페이지 비활성화.
ADMIN_PASSWORD=

# Phase 3 (어드민에서 편집 → GitHub commit) 용. 미설정 시 편집 기능 비활성화.
GITHUB_TOKEN=
GITHUB_REPO=

# ============================================================
# iframe 임베드 (insight-out 호스트에서 COUNCIL 을 임베드)
# ============================================================
# COUNCIL 을 iframe 으로 띄울 수 있는 호스트 오리진 화이트리스트.
# 공백/콤마 구분. 미설정 시 아래 기본값:
#   https://insight-out-app.vercel.app http://localhost:3000 http://localhost:3001
# - 서버측(frame-ancestors CSP 헤더)에서 프레이밍 허용 대상 제한에 사용.
# - 클라이언트측(postMessage 신뢰 오리진)에는 NEXT_PUBLIC_ 사본이 필요.
EMBED_ALLOWED_ORIGINS=
NEXT_PUBLIC_EMBED_ALLOWED_ORIGINS=

# ============================================================
# insight-out MI 연동 (③ 능동 조회)
# ============================================================
# COUNCIL 서버(/api/mi)가 insight-out `/api/council` 를 호출해
# 콘텐츠·이슈·기업동향(외부 인사이트 포함)을 토론·페르소나에 주입한다.
# ⚠️ 토큰은 서버 전용 — NEXT_PUBLIC_ 접두사 절대 금지(브라우저 노출 시 유출).
# 미설정 시 MI 없이 COUNCIL 이 정상 동작한다.
#
# INSIGHT_OUT_API_URL   : insight-out 배포 URL (예: https://insight-out-app.vercel.app)
# INSIGHT_OUT_READ_TOKEN: insight-out 어드민(/admin/mcp)에서 발급한 read 스코프 토큰(io_...)
INSIGHT_OUT_API_URL=
INSIGHT_OUT_READ_TOKEN=

# ============================================================
# 서버키 프록시 (로그인 사용자가 서버 등록 키로 토론 — 키 입력 불필요)
# ============================================================
# 로그인 게이트 공유 비밀 — insight-out 과 동일한 값이어야 함(티켓 서명·검증).
#   생성 예: openssl rand -hex 32
# 미설정 시 서버키 프록시가 전면 비활성(=BYOK 만 동작).
COUNCIL_GATE_SECRET=
#
# 공급사별 서버 키 — 콤마로 여러 개(같은 공급사 여러 키 = 무료한도 곱).
# ⚠️ NEXT_PUBLIC_ 접두 절대 금지(서버 전용). 키 넣은 공급사만 자동 활성.
#   단일: GROQ_API_KEY=gsk_xxx     /  다중: GROQ_API_KEYS=gsk_a,gsk_b,gsk_c
GROQ_API_KEYS=
GEMINI_API_KEYS=
CEREBRAS_API_KEYS=
OPENROUTER_API_KEYS=
MISTRAL_API_KEYS=
SAMBANOVA_API_KEYS=
NVIDIA_API_KEYS=
TOGETHER_API_KEYS=
GITHUB_MODELS_API_KEYS=
